# ============================================================
# Stock Terminal v2.0 — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# User-specific data — should not be committed
# (each user generates their own ETF snapshots and logs)
etf_history/*.json
etf_history/*.txt
!etf_history/README.txt

logs/
logs/*
data/logs/

# Build / distribution outputs (built fresh on demand)
Stock_Terminal/
Stock_Terminal_*.zip
*.zip
Stock_Terminal_*.zip.sha256
Stock_Terminal_*.manifest.json

# Local feature-flag overrides (research / shadow surfaces)
data/feature_flags.local.json

# 盤後敘事日報本機存檔（POST /api/ai/postmarket-daily 產物，可重建）
data/reports/

*.key
.env
.env.local
secrets.json

# v3.8 Alert daemon — contains Telegram token / SMTP app password / rules
alert_config.json
alert_rules.json

# v3.8 WATCH backend daemon + ETF report state (user data)
watch_rules.json
watch_state.json
chip_history/

# v3.9 P3 drawing cloud memory (per-user chart annotations)
draw_store.json

# Backup / temp files
*.bak
*.tmp
*.orig
*~

# Browser localStorage backups (if anyone exports manually)
positions_backup.json
watches_backup.json

# ============================================================
# v3.9 modularization (P3/P4) — new /data layout + tooling
# ============================================================
