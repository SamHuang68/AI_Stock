# ============================================================
# Stock Terminal v2.0 — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# User-specific data — should not be committed
# (each user generates their own ETF snapshots and logs)
etf_history/*.json
etf_history/*.txt
!etf_history/README.txt

logs/
logs/*

# Build / distribution outputs (built fresh on demand)
Stock_Terminal/
Stock_Terminal_*.zip
*.zip

# Local API keys and secrets (just in case)
*.key
.env
.env.local
secrets.json

# v3.8 Alert daemon — contains Telegram token / SMTP app password / rules
alert_config.json
alert_rules.json

# v3.8 WATCH backend daemon + ETF report state (user data)
watch_rules.json
watch_state.json
chip_history/

# v3.9 P3 drawing cloud memory (per-user chart annotations)
draw_store.json

# Backup / temp files
*.bak
*.tmp
*.orig
*~

# Browser localStorage backups (if anyone exports manually)
positions_backup.json
watches_backup.json

# ============================================================
# v3.9 modularization (P3/P4) — new /data layout + tooling
# ============================================================
# Secret — Claude API key (NEVER commit)
ai_key.txt
data/ai_key.txt
# Moved user data/snapshots (keep out of git, same as before the move)
data/etf_history/
data/chip_history/
data/draw_store.json
data/alert_config.json
data/alert_rules.json
data/watch_rules.json
data/watch_state.json
# Node test tooling accidentally installed during refactor
node_modules/
# Stray test/junk file
_tb_test.js

# Ad-hoc scratch probes (use tests/ for real tests)
scratch/

# Cursor / agent leftover prompts (project rules live in .cursorrules)
.agent/

# Installer build artifacts (PyInstaller + Inno Setup output)
installer/build/
installer/dist_installer/
*.exe
*.spec

# v4.0 local market datastore (regenerable, can grow large)
data/market.db
data/market.db-wal
data/market.db-shm
data/macro_track.db
data/macro_track.db-wal
data/macro_track.db-shm

# H0/H3：大 DB 改首次回補，不再進 git／分享包
data/tdcc_holders.db
data/tdcc_holders.db-wal
data/tdcc_holders.db-shm
data/margin_cycle.db
data/margin_cycle.db-wal
data/margin_cycle.db-shm
baml_hy.csv
baml_ig.csv
fedfunds.csv
us10y.csv
us_cpi_yoy.csv
xlf.csv
